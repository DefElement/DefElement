name: Hu-Zhang-Zhang
html-name: Hu&ndash;Zhang&ndash;Zhang
polynomial-subdegree: k
degree: polynomial-subdegree
mapping: see {{citation::kirby_mapping}}
reference-cells:
- tetrahedron
